# Stage 1: Build Vite React App
FROM node:20-alpine AS builder

WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

# Stage 2: Serve with Nginx
FROM nginx:alpine

COPY --from=builder /app/dist /usr/share/nginx/html
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf

# Reconfigure default.conf for docker proxying (frontend -> backend container)
RUN sed -i 's|http://127.0.0.1:8000|http://backend:8000|g' /etc/nginx/conf.d/default.conf && \
    sed -i 's|root /var/www/alumni/dist;|root /usr/share/nginx/html;|g' /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]

