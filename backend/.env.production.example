# Production Environment Configuration for AWS

# Database URL
# For SQLite on persistent EBS volume:
DATABASE_URL=sqlite:///./alumni.sqlite3
# OR for AWS RDS PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://user:password@rds-endpoint.c123.ap-south-1.rds.amazonaws.com:5432/alumni_db
# OR for AWS RDS MySQL:
# DATABASE_URL=mysql+pymysql://user:password@rds-endpoint.c123.ap-south-1.rds.amazonaws.com:3306/alumni_db

# Security & Secrets
JWT_SECRET_KEY=change-this-to-a-very-secure-random-64-character-string
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-admin-password-here
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com

# AWS S3 Bucket Configuration for Photos & Uploads
AWS_STORAGE_BUCKET_NAME=your-alumni-s3-bucket-name
AWS_REGION=ap-south-1
# Note: If running on EC2 with an attached IAM Role, leave ACCESS_KEY and SECRET_KEY blank!
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: If you use CloudFront CDN in front of S3
# AWS_S3_CUSTOM_DOMAIN=cdn.yourdomain.com

# Local Directory Paths (fallback/cache)
UPLOAD_DIR=./private_uploads
PROFILE_IMAGE_DIR=./profile_images
GALLERY_IMAGE_DIR=./gallery_images
BACKUP_DIR=./backups

